# Backend environment
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (replace <user> and <pass> / cluster / db)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/habits?retryWrites=true&w=majority&appName=<your-app-name>

# JWT secret for signing tokens (use a long random string)
JWT_SECRET=replace_with_a_long_random_string

# CORS: your frontend origin (e.g., http://localhost:3000 for dev; https://your-frontend.vercel.app in prod)
CORS_ORIGIN=http://localhost:3000