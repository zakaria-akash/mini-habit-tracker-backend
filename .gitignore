
# ------------------------------
# Node / Runtime
# ------------------------------
node_modules/
# Keep lock files tracked for reproducible installs:
# (Do NOT ignore package-lock.json / yarn.lock / pnpm-lock.yaml)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Process IDs & runtime artifacts
pids/
*.pid
*.seed
*.pid.lock

# Debug & REPL history
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
node-repl-history

# Cache
.npm/
.yarn/
.pnpm-store/
.eslintcache
.cache/
.tmp/

# Coverage & test outputs
coverage/
.nyc_output/
reports/

# Build outputs (if any)
dist/
build/

# ------------------------------
# Environment & Secrets
# ------------------------------
# Never commit secrets. Keep example only.
!.env.example

# ------------------------------
# Logs
# ------------------------------
logs/
log/
*.log

# ------------------------------
# Editors & OS junk
# ------------------------------
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/

# Swap files
*.swp
*.swo

# ------------------------------
# Redis & Database dumps (if created in repo dir)
# ------------------------------
# Redis persistence files
dump.rdb
appendonly.aof
*.rdb
*.aof

# Mongo export dumps (avoid storing DB files in repo)
*.bson
*.wt

# ------------------------------
# Temporary data folders (optional)
# Uncomment if you create local storage dirs in the project
# ------------------------------
# uploads/
# storage/
# temp/
# tmp/

# ------------------------------
# Mailer templates/build (if generated)
# ------------------------------
# mail_build/
config.bat
